{
	"name": "emdash-plugin-sheet-table",
	"version": "0.2.0",
	"description": "Google Sheets to table plugin for EmDash CMS. Show live, searchable, sortable tables from Google Sheets, with tabs, private sheets and auto-sync.",
	"type": "module",
	"main": "./dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./admin": "./src/admin/index.tsx",
		"./astro": "./src/astro/index.ts"
	},
	"files": [
		"dist",
		"src/admin",
		"src/astro",
		"src/lib"
	],
	"scripts": {
		"build": "tsdown src/index.ts --format esm --dts --clean",
		"dev": "tsdown src/index.ts --format esm --dts --watch",
		"typecheck": "tsc --noEmit",
		"check": "astro check",
		"test": "vitest run",
		"prepublishOnly": "npm run typecheck && npm run build && npm test"
	},
	"keywords": [
		"emdash",
		"emdash-plugin",
		"google-sheets",
		"spreadsheet",
		"table",
		"tabs",
		"astro"
	],
	"license": "MIT",
	"author": "Kazi Badrul (https://kazibadrul.com)",
	"homepage": "https://kazibadrul.com/sheet-table/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alamriku/emdash-cms-sheet-to-table.git"
	},
	"bugs": {
		"url": "https://github.com/alamriku/emdash-cms-sheet-to-table/issues"
	},
	"peerDependencies": {
		"astro": ">=6.0.0-beta.0",
		"emdash": "*",
		"react": "^18.0.0 || ^19.0.0"
	},
	"dependencies": {
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@types/react": "^19.0.0",
		"tsdown": "^0.20.0",
		"typescript": "^5.9.0",
		"vitest": "^3.2.7"
	}
}
