---
import { containerAttributes, renderTableHtml } from "../lib/render.js";
import type { TableRenderPayload } from "../lib/types.js";
import "./sheet-table.css";

interface SheetTableNode {
	_type: "sheet-table";
	_key: string;
	tableId?: string;
}

interface Props {
	node: SheetTableNode;
}

const { node } = Astro.props;
const tableId = node.tableId?.trim() ?? "";
const endpoint = tableId ? `/_emdash/api/plugins/sheet-table/render?id=${encodeURIComponent(tableId)}` : "";

// A table's "Load asynchronously" setting decides how it renders. When it's on, skip straight to the
// client-fetched "Loading…" placeholder below — no server-side sheet fetch here, so a slow or stale
// Google Sheet sync never blocks this page's response. When it's off, the owner has opted into server
// rendering: fetch the snapshot now and emit real <table> markup, so the table works without JS and
// shows up in view-source for crawlers. The client script then takes over the same markup.
//
// The initial request is a cheap `metaOnly` lookup — a local read of the table's settings with no
// Google Sheets call — so async tables never pay for a fetch they don't want.
let ssrPayload: TableRenderPayload | null = null;
if (tableId) {
	try {
		const metaResponse = await fetch(new URL(`${endpoint}&metaOnly=1`, Astro.url));
		const metaBody = await metaResponse.json();
		if (metaBody?.data?.asyncLoading === false) {
			const fullResponse = await fetch(new URL(endpoint, Astro.url));
			const fullBody = await fullResponse.json();
			if (fullBody?.data && Array.isArray(fullBody.data.rows)) {
				ssrPayload = fullBody.data as TableRenderPayload;
			}
		}
	} catch {
		// Any failure here (network, parse, timeout) just falls back to the client-loaded path below.
	}
}
const ssrAttributes = ssrPayload ? containerAttributes(ssrPayload) : null;
---

{
	tableId ? (
		ssrPayload && ssrAttributes ? (
			<div
				class={ssrAttributes.className}
				style={ssrAttributes.style || undefined}
				data-sheet-table-id={tableId}
				data-sheet-table-endpoint={endpoint}
			>
				{/* Read by hydrate() so the client attaches search/sort/pagination without another request.
				    `<` is escaped so a cell value can't break out of the script tag. */}
				<script
					type="application/json"
					data-sheet-table-payload
					set:html={JSON.stringify(ssrPayload).replace(/</g, "\\u003c")}
				/>
				<Fragment set:html={renderTableHtml(ssrPayload)} />
			</div>
		) : (
			<div class="emdash-sheet-table" data-sheet-table-id={tableId} data-sheet-table-endpoint={endpoint}>
				<p class="emdash-sheet-table__loading">Loading table…</p>
			</div>
		)
	) : (
		<p class="emdash-sheet-table emdash-sheet-table--unconfigured">Sheet Table block: no table selected yet.</p>
	)
}

<script>
	import { mountTable } from "../lib/render.js";
	import type { TableRenderPayload } from "../lib/types.js";

	async function hydrate(container: HTMLElement) {
		// Server-rendered tables embed their payload, so no network round trip is needed.
		const dataScript = container.querySelector<HTMLScriptElement>("script[data-sheet-table-payload]");
		if (dataScript) {
			try {
				mountTable(container, JSON.parse(dataScript.textContent ?? "") as TableRenderPayload);
				return;
			} catch {
				// Malformed embedded payload: fall through to the network fetch below.
			}
		}

		const endpoint = container.dataset.sheetTableEndpoint;
		if (!endpoint) return;
		try {
			const response = await fetch(endpoint, { headers: { Accept: "application/json" } });
			const body = await response.json();
			const payload: TableRenderPayload | undefined = body?.data;
			if (!payload || !Array.isArray(payload.rows)) {
				container.innerHTML = '<p class="emdash-sheet-table__error">This table could not be found.</p>';
				return;
			}
			mountTable(container, payload);
		} catch {
			container.innerHTML = '<p class="emdash-sheet-table__error">This table could not be loaded.</p>';
		}
	}

	/**
	 * CSS centers a "wide"/"full" box on the content column, which only matches the page's center when
	 * the column itself is centered. With a sidebar on one side it isn't, and the box can run off the
	 * screen. This nudges each box back inside the viewport, keeping a 16px gap. Tables inside a tab
	 * group are skipped: they fill the group, and the group is nudged instead.
	 */
	const SCREEN_GAP = 16;
	function fitBreakouts() {
		const viewport = document.documentElement.clientWidth;
		document.documentElement.style.setProperty("--ft-viewport", `${viewport}px`);
		document.querySelectorAll<HTMLElement>(".emdash-sheet-width--wide, .emdash-sheet-width--full").forEach((el) => {
			if (!el.classList.contains("emdash-sheet-tabs") && el.closest(".emdash-sheet-tabs")) return;
			el.style.removeProperty("--ft-shift");
			const rect = el.getBoundingClientRect();
			let shift = 0;
			if (rect.left < SCREEN_GAP) shift = SCREEN_GAP - rect.left;
			else if (rect.right > viewport - SCREEN_GAP) shift = viewport - SCREEN_GAP - rect.right;
			if (shift) el.style.setProperty("--ft-shift", `${Math.round(shift)}px`);
		});
	}

	let fitFrame = 0;
	window.addEventListener("resize", () => {
		cancelAnimationFrame(fitFrame);
		fitFrame = requestAnimationFrame(fitBreakouts);
	});

	// Async tables only get their width class once their data arrives, so fit again after each one.
	document
		.querySelectorAll<HTMLElement>(".emdash-sheet-table[data-sheet-table-endpoint]")
		.forEach((container) => void hydrate(container).then(fitBreakouts));
	fitBreakouts();
</script>
